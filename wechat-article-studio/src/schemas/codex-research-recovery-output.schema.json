{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wechat-article-studio.local/schemas/codex-research-recovery-output.v1.json",
  "title": "Wechat Article Studio audited source excerpt recovery output",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "excerpt", "locator"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
