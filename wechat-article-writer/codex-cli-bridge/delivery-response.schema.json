{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/content-desk/delivery-response.schema.json",
  "title": "Content Desk MultiPost delivery response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deliveryId", "deliveryManifestId", "sourceManifestId", "documentId", "revisionId", "contentHash", "contentType", "accountIds", "groupId", "state", "targets", "upstreamStatus", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "content-desk.delivery.v1", "type": "string" },
    "deliveryId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "deliveryManifestId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sourceManifestId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "revisionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "contentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "contentType": { "const": "ARTICLE", "type": "string" },
    "accountIds": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "groupId": { "type": ["string", "null"], "maxLength": 256 },
    "state": { "type": "string", "enum": ["publishing", "awaiting_ready", "ready_to_submit", "submitted_pending", "submitting", "retrying", "prefill_unknown", "submit_unknown", "target_retry_unknown", "succeeded", "failed", "partial_failed", "partial_cancelled", "cancelled"] },
    "targets": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accountId", "status"],
        "properties": {
          "accountId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "platform": { "type": "string", "maxLength": 128 },
          "status": { "type": "string", "enum": ["pending", "filling", "ready", "success", "failed", "cancelled"] },
          "postUrl": { "type": "string", "maxLength": 4096 },
          "error": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "upstreamStatus": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "attemptOfDeliveryId": { "type": "string", "maxLength": 256 },
    "eventCount": { "type": "integer", "minimum": 1 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
