{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-desk.corpus-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "mode", "rightsAttestation", "state", "createdAt", "updatedAt", "manifestHash", "canConfirm", "files", "snapshot", "corpusSnapshot"],
  "properties": {
    "schemaVersion": { "const": "content-desk.corpus-package.v1" },
    "packageId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "enum": ["writing", "academic"] },
    "rightsAttestation": { "enum": ["self_authored", "permission_granted", "licensed", "public_domain"] },
    "state": { "enum": ["staging", "ready_to_confirm", "confirmed", "rejected"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canConfirm": { "type": "boolean" },
    "created": { "type": "boolean" },
    "idempotent": { "type": "boolean" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileId", "clientFileId", "name", "mediaType", "mimeType", "bytes", "state", "uploadedBytes", "sha256", "normalizedTextHash", "parserVersion", "issues", "charCount", "characterCount", "lineCount"],
        "properties": {
          "fileId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "clientFileId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 180 },
          "mediaType": { "type": "string" },
          "mimeType": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 1 },
          "state": { "enum": ["awaiting_upload", "parsed"] },
          "uploadedBytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "normalizedTextHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "parserVersion": { "type": "string" },
          "issues": { "type": "array", "items": { "type": "string" } },
          "characterCount": { "type": ["integer", "null"], "minimum": 0 },
          "charCount": { "type": ["integer", "null"], "minimum": 0 },
          "lineCount": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "snapshot": { "anyOf": [{ "$ref": "content-desk.corpus-snapshot.v1" }, { "type": "null" }] },
    "corpusSnapshot": { "anyOf": [{ "$ref": "content-desk.corpus-snapshot.v1" }, { "type": "null" }] }
  }
}
